---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher';
import LanguageSwitcher from '../components/LanguageSwitcher';
import MobileMenuDialog from '../components/MobileMenuDialog';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  titleEn?: string;
  description: string;
  ogImage?: string;
  currentPath?: string;
}

const {
  title,
  titleEn,
  description,
  ogImage = '/assets/packs/bunny-4cut/preview.png',
  currentPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(currentPath, Astro.site ?? 'https://gamseong-photo.vercel.app');
const absoluteOgImage = new URL(ogImage, Astro.site ?? 'https://gamseong-photo.vercel.app');
---

<!doctype html>
<html lang="id" data-lang="id" data-theme="yellow">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={absoluteOgImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@500;700&display=swap"
    />

    <script is:inline define:vars={{ titleId: title, titleEn: titleEn ?? title }}>
      try {
        var savedTheme = localStorage.getItem('gamseong.theme');
        if (savedTheme === 'yellow' || savedTheme === 'pink' || savedTheme === 'blue') {
          document.documentElement.dataset.theme = savedTheme;
        }
        var savedLang = localStorage.getItem('gamseong.lang');
        var activeLang = savedLang === 'en' ? 'en' : 'id';
        document.documentElement.lang = activeLang;
        document.documentElement.dataset.lang = activeLang;
        document.title = activeLang === 'en' ? titleEn : titleId;
        window.addEventListener('gamseong:lang-changed', function (ev) {
          var next = ev && ev.detail === 'en' ? 'en' : 'id';
          document.title = next === 'en' ? titleEn : titleId;
        });
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      <span data-lang-block="id">Langsung ke konten utama</span>
      <span data-lang-block="en">Skip to main content</span>
    </a>

    <header class="sticky top-0 z-30 border-b-2 border-[var(--ink)] bg-[var(--bg)]">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-2.5 sm:gap-3 sm:px-6 sm:py-3">
        <a
          href="/"
          class="group inline-flex min-h-[44px] min-w-0 items-center gap-2 rounded-xl pr-1 text-[var(--ink)] no-underline sm:gap-2.5"
        >
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border-2 border-[var(--ink)] bg-[var(--accent)] text-[var(--on-accent)] transition-transform group-hover:-rotate-3 sm:h-10 sm:w-10"
            aria-hidden="true"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="6" y="2.5" width="12" height="19" rx="2"></rect>
              <line x1="6" y1="7.5" x2="18" y2="7.5"></line>
              <line x1="6" y1="12.5" x2="18" y2="12.5"></line>
              <line x1="6" y1="17.5" x2="18" y2="17.5"></line>
            </svg>
          </span>
          <span class="flex min-w-0 flex-col leading-tight">
            <span class="truncate font-[var(--font-display)] text-sm font-extrabold tracking-tight sm:text-lg">
              GAMSEONG PHOTO
            </span>
            <span class="truncate text-[11px] font-semibold text-[var(--ink-muted)] sm:text-xs">
              <span data-lang-block="id">Koleksi Prompt 감성네컷</span>
              <span data-lang-block="en">감성네컷 Prompt Packs</span>
            </span>
          </span>
        </a>

        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
          <div class="hidden items-center gap-3 md:flex">
            <nav aria-label="Navigasi utama" class="flex items-center gap-1">
              <a
                href="/"
                aria-current={currentPath === '/' ? 'page' : undefined}
                class={`inline-flex min-h-[44px] items-center rounded-xl px-4 py-2 text-sm font-bold no-underline transition-colors ${
                  currentPath === '/'
                    ? 'border-2 border-[var(--ink)] bg-[var(--accent)] text-[var(--on-accent)]'
                    : 'border-2 border-transparent text-[var(--ink)] hover:border-[var(--ink)] hover:bg-[var(--surface)]'
                }`}
              >
                <span data-lang-block="id">Koleksi Prompt</span>
                <span data-lang-block="en">Prompt Packs</span>
              </a>
              <a
                href="/how-to"
                aria-current={currentPath.startsWith('/how-to') ? 'page' : undefined}
                class={`inline-flex min-h-[44px] items-center rounded-xl px-4 py-2 text-sm font-bold no-underline transition-colors ${
                  currentPath.startsWith('/how-to')
                    ? 'border-2 border-[var(--ink)] bg-[var(--accent)] text-[var(--on-accent)]'
                    : 'border-2 border-transparent text-[var(--ink)] hover:border-[var(--ink)] hover:bg-[var(--surface)]'
                }`}
              >
                <span data-lang-block="id">Cara Pakai</span>
                <span data-lang-block="en">How to Use</span>
              </a>
            </nav>

            <ThemeSwitcher client:load />
          </div>

          <MobileMenuDialog currentPath={currentPath} client:load />

          <!-- Language toggle pinned at top-right corner on all viewports -->
          <LanguageSwitcher client:load />
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t-2 border-[var(--ink)] bg-[var(--surface)]">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="font-[var(--font-display)] text-base font-extrabold text-[var(--ink)]">
            GAMSEONG PHOTO <span class="font-semibold text-[var(--ink-muted)]">감성네컷</span>
          </p>
          <p class="mt-1 max-w-md text-sm text-[var(--ink-muted)]">
            <span data-lang-block="id">
              Koleksi prompt photo booth ala Korea lengkap dengan file referensi untuk aplikasi Gemini. Gratis, tanpa login atau API key.
            </span>
            <span data-lang-block="en">
              Free Korean photo-booth prompt packs and reference kits designed for the Gemini app. No login or API key required.
            </span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/"
            class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)] underline-offset-4 hover:underline"
          >
            <span data-lang-block="id">Semua Pack</span>
            <span data-lang-block="en">All Packs</span>
          </a>
          <a
            href="/how-to"
            class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)] underline-offset-4 hover:underline"
          >
            <span data-lang-block="id">Cara Pakai</span>
            <span data-lang-block="en">How to Use</span>
          </a>
          <a
            href={SITE_CONFIG.geminiAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)] underline-offset-4 hover:underline"
          >
            <span data-lang-block="id">Buka Aplikasi Gemini</span>
            <span data-lang-block="en">Open Gemini App</span>
          </a>
          {
            SITE_CONFIG.supportUrl && (
              <a
                href={SITE_CONFIG.supportUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center rounded-xl border-2 border-[var(--ink)] bg-[var(--surface-tint)] px-3.5 py-2 text-sm font-bold text-[var(--ink)] no-underline transition-colors hover:bg-[var(--accent)]"
              >
                <span data-lang-block="id">Dukung proyek ini</span>
                <span data-lang-block="en">Support this project</span>
              </a>
            )
          }
        </div>
      </div>
    </footer>
  </body>
</html>
