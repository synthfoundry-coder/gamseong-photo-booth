---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher';
import MobileMenuDialog from '../components/MobileMenuDialog';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  currentPath?: string;
}

const {
  title,
  description,
  ogImage = '/assets/packs/bunny-4cut/preview.png',
  currentPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(currentPath, Astro.site ?? 'https://gamseong-photo.vercel.app');
const absoluteOgImage = new URL(ogImage, Astro.site ?? 'https://gamseong-photo.vercel.app');
---

<!doctype html>
<html lang="en" data-theme="yellow">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={absoluteOgImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@500;700&display=swap"
    />

    <script is:inline>
      try {
        var saved = localStorage.getItem('gamseong.theme');
        if (saved === 'yellow' || saved === 'pink' || saved === 'blue') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="sticky top-0 z-30 border-b-2 border-[var(--ink)] bg-[var(--bg)]">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="group inline-flex min-h-[44px] items-center gap-2.5 rounded-xl pr-2 text-[var(--ink)] no-underline"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[var(--ink)] bg-[var(--accent)] text-[var(--on-accent)] transition-transform group-hover:-rotate-3"
            aria-hidden="true"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="6" y="2.5" width="12" height="19" rx="2"></rect>
              <line x1="6" y1="7.5" x2="18" y2="7.5"></line>
              <line x1="6" y1="12.5" x2="18" y2="12.5"></line>
              <line x1="6" y1="17.5" x2="18" y2="17.5"></line>
            </svg>
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-[var(--font-display)] text-base font-extrabold tracking-tight sm:text-lg">
              GAMSEONG PHOTO
            </span>
            <span class="text-xs font-semibold text-[var(--ink-muted)]">
              감성네컷 Prompt Packs
            </span>
          </span>
        </a>

        <div class="hidden items-center gap-5 md:flex">
          <nav aria-label="Primary navigation" class="flex items-center gap-1">
            <a
              href="/"
              aria-current={currentPath === '/' ? 'page' : undefined}
              class={`inline-flex min-h-[44px] items-center rounded-xl px-4 py-2 text-sm font-bold no-underline transition-colors ${
                currentPath === '/'
                  ? 'border-2 border-[var(--ink)] bg-[var(--accent)] text-[var(--on-accent)]'
                  : 'border-2 border-transparent text-[var(--ink)] hover:border-[var(--ink)] hover:bg-[var(--surface)]'
              }`}
            >
              Prompt Packs
            </a>
            <a
              href="/how-to"
              aria-current={currentPath.startsWith('/how-to') ? 'page' : undefined}
              class={`inline-flex min-h-[44px] items-center rounded-xl px-4 py-2 text-sm font-bold no-underline transition-colors ${
                currentPath.startsWith('/how-to')
                  ? 'border-2 border-[var(--ink)] bg-[var(--accent)] text-[var(--on-accent)]'
                  : 'border-2 border-transparent text-[var(--ink)] hover:border-[var(--ink)] hover:bg-[var(--surface)]'
              }`}
            >
              How to Use
            </a>
          </nav>

          <ThemeSwitcher client:load />
        </div>

        <MobileMenuDialog currentPath={currentPath} client:load />
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t-2 border-[var(--ink)] bg-[var(--surface)]">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="font-[var(--font-display)] text-base font-extrabold text-[var(--ink)]">
            GAMSEONG PHOTO <span class="font-semibold text-[var(--ink-muted)]">감성네컷</span>
          </p>
          <p class="mt-1 max-w-md text-sm text-[var(--ink-muted)]">
            Free Korean photo-booth prompt packs and reference kits designed for the Gemini app. No login or API key required.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/"
            class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)] underline-offset-4 hover:underline"
          >
            All Packs
          </a>
          <a
            href="/how-to"
            class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)] underline-offset-4 hover:underline"
          >
            How to Use
          </a>
          <a
            href={SITE_CONFIG.geminiAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-semibold text-[var(--ink)] underline-offset-4 hover:underline"
          >
            Open Gemini App
          </a>
          {
            SITE_CONFIG.supportUrl && (
              <a
                href={SITE_CONFIG.supportUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center rounded-xl border-2 border-[var(--ink)] bg-[var(--surface-tint)] px-3.5 py-2 text-sm font-bold text-[var(--ink)] no-underline transition-colors hover:bg-[var(--accent)]"
              >
                Support this project
              </a>
            )
          }
        </div>
      </div>
    </footer>
  </body>
</html>
